[Unit]
Description=VA-Connect Watchdog Web
After=local-fs.target

[Service]
Type=notify
ExecStart=/bin/sh -c 'if [ -x /opt/va-connect-watchdog-v3/.venv/bin/python ]; then exec /opt/va-connect-watchdog-v3/.venv/bin/python -m va_watchdog.web_service; else exec /usr/bin/python3 -m va_watchdog.web_service; fi'
WorkingDirectory=/opt/va-connect-watchdog-v3/v3
Restart=on-failure
RestartSec=5
WatchdogSec=30
NotifyAccess=main
User=root
Group=root

[Install]
WantedBy=multi-user.target
