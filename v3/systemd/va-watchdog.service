[Unit]
Description=VA-Connect Watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/opt/va-connect-watchdog-v3/.venv/bin/python -m va_watchdog.watchdog
WorkingDirectory=/opt/va-connect-watchdog-v3/v3
Restart=always
RestartSec=5
WatchdogSec=30
NotifyAccess=main
CPUAccounting=true
MemoryAccounting=true
MemoryMax=256M
TasksMax=64
User=root
Group=root

[Install]
WantedBy=multi-user.target
